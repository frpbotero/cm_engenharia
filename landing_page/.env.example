# RESEND_API_KEY: Required for sending contact form emails.
# Get your key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# RESEND_FROM_EMAIL: Sender address shown in the email.
# Must use a domain verified in Resend. During development you can use onboarding@resend.dev
RESEND_FROM_EMAIL="CM Engenharia <noreply@cmengenharia.com>"

# CONTACT_EMAIL: Destination address that receives the contact form submissions.
CONTACT_EMAIL="contato@cmengenharia.com"
